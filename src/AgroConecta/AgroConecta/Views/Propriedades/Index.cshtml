@model IEnumerable<AgroConecta.Models.Propriedade>

@{
    ViewData["Title"] = "Propriedades";
}

<h1 class="page-title">Propriedades</h1>

<div class="agro-card">

    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Create" class="agro-link">
            + Nova propriedade
        </a>
    </div>

    <table class="agro-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Área</th>
                <th>Localização</th>
                <th>CIB</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Area ha</td>
                    <td>@item.LocalizacaoGeo</td>
                    <td>@item.Cib</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="agro-action">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="agro-action">Detalhes</a>
                        <a asp-controller="Relatorios"
       asp-action="Create"
       asp-route-propriedadeId="@item.Id"
       class="agro-action">
        Criar relatório
    </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="agro-action danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
