@model AgroConecta.Models.Propriedade

@{
    ViewData["Title"] = "Cadastrar Propriedade";
}

<h1 class="page-title">Cadastrar Propriedade</h1>

<div class="d-flex justify-content-end gap-2 mb-4">
    <a asp-controller="Culturas"
       asp-action="Index"
       class="agro-link">
        Visualizar culturas
    </a>

    <a asp-controller="Culturas"
       asp-action="Create"
       class="agro-link">
        + Criar cultura
    </a>
</div>

<div class="agro-card form-card">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Nome"
               class="agro-input"
               placeholder="Nome" />

        <input asp-for="LocalizacaoGeo"
               class="agro-input"
               placeholder="Localização" />

        <input asp-for="Area"
       type="number"
       step="0.01"
       class="agro-input"
       placeholder="Área Total" />

        <input asp-for="Cib"
               class="agro-input"
               placeholder="CIB" />

        <!--temporariamente -->
        <input asp-for="CriadoPor"
               type="hidden"
               value="1" />

        <button type="submit" class="agro-btn">
            Salvar
        </button>

    </form>

</div>
