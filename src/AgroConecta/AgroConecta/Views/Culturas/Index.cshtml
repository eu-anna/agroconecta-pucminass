@model IEnumerable<AgroConecta.Models.Cultura>
@{
    ViewData["Title"] = "Culturas";
}
<h1 class="page-title">Culturas</h1>
<div class="agro-card">
    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Create"
           class="agro-btn"
           style="width:auto; min-width:220px; text-decoration:none; text-align:center; padding:14px 24px;">
            + Nova cultura
        </a>
    </div>
    <table class="agro-table">
        <thead>
            <tr>
                <th>Cultura</th>
                <th>Propriedade</th>
                <th>Área</th>
                <th>Plantio</th>
                <th>Colheita Prevista</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cultura in Model)
            {
                <tr>
                    <td>@cultura.NomeCultura</td>
                    <td>@cultura.Propriedade?.Nome</td>
                    <td>@cultura.AreaPlantio ha</td>
                    <td>@cultura.DataPlantio?.ToString("dd/MM/yyyy")</td>
                    <td>@cultura.DataPrevistaColheita?.ToString("dd/MM/yyyy")</td>
                    <td>@cultura.Status</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@cultura.Id"
                           class="agro-action">
                            Ver
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@cultura.Id"
                           class="agro-action">
                            Editar
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@cultura.Id"
                           class="agro-action danger">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
