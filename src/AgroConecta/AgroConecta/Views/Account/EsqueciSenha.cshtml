<h2>Recuperar Senha</h2>

<form method="post">
    <input type="email"
           name="email"
           placeholder="Digite seu e-mail"
           required />

    <button type="submit">
        Gerar Link
    </button>
</form>

@if (ViewBag.Mensagem != null)
{
    <p>@ViewBag.Mensagem</p>
}

@if (ViewBag.LinkTeste != null)
{
    <a href="@ViewBag.LinkTeste">
        Abrir Link de Recuperação
    </a>
}
