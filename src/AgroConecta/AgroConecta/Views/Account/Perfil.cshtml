@model AgroConecta.Models.Usuario

@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container mt-5">

    <div class="agro-card form-card mx-auto" style="max-width: 500px;">

        <h1 class="page-title text-center">
            Meu Perfil
        </h1>

        @if (ViewBag.Sucesso != null)
        {
            <div class="alert alert-success">
                @ViewBag.Sucesso
            </div>
        }

        <form asp-action="Perfil" method="post">

            <input asp-for="Nome"
                   class="agro-input"
                   placeholder="Nome" />

            <input asp-for="Email"
                   class="agro-input"
                   placeholder="Email" />

            <select asp-for="TipoUsuario"
                    class="agro-input">

                <option value="Produtor">Produtor</option>
                <option value="Consumidor">Consumidor</option>
                <option value="Técnico">Técnico</option>

            </select>

            <button type="submit"
                    class="agro-btn w-100">

                Salvar Alterações

            </button>

            <a asp-controller="Account"
   asp-action="DesativarConta"
   class="btn btn-danger w-100 mt-3"
   onclick="return confirm('Tem certeza que deseja desativar sua conta?');">
    Desativar minha conta
</a>

        </form>

    </div>

</div>
