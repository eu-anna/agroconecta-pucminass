@model IEnumerable<AgroConecta.Models.Produto>

@{
    ViewData["Title"] = "MarketPlace";
    var tipo = Context.Session.GetString("TipoUsuario");
}

<div class="container mt-4">
    <h4 class="fw-semibold mb-4 text-center" style="color: #496326;"> Nossos Produtos </h4>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white shadow-sm rounded-4 px-3">
            <div class="mb-3 text-muted opacity-50">
                <i class="bi bi-basket fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark"> Oops! </h5>
            <p class="text-muted small mb-0">Parece que nossa prateleira está vazia no momento. Volte mais tarde!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 h-100 overflow-auto p-1">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 bg-white shadow-sm border rounded-4 overflow-hidden d-flex flex-row d-md-flex flex-md-column card-hover-effect">

                        <div class="ratio ratio-1x1 d-flex align-items-center justify-content-center bg-light border-end border-md-end-0 border-md-bottom position-relative custom-mobile-img" style="max-height: 260px;">
                            @if (item.Imagem != null && item.Imagem.Length > 0)
                            {
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.Imagem)"
                                     alt="@item.Nome"
                                     class="w-100 h-100 object-fit-cover" />
                            }
                            else
                            {
                                <div class="text-muted small fw-semibold opacity-75 text-uppercase w-100 h-100 d-flex align-items-center justify-content-center flex-column">
                                    <i class="fs-1 bi bi-card-image"></i>
                                    Sem foto
                                </div>
                            }
                        </div>

                        <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1 w-100">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">
                                        @(item.Categoria?.Nome ?? "Sem categoria")
                                    </span>

                                    <div class="ms-auto">
                                        @if (item.Estoque <= 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.65rem;">Esgotado</span>
                                        }
                                        else if (item.Estoque <= 5)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill" style="font-size: 0.65rem;">Restam @item.Estoque</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.65rem;">Em Estoque</span>
                                        }
                                    </div>
                                </div>

                                <h5 class="card-title fw-semibold fs-6 lh-base text-dark mb-2">
                                    @item.Nome
                                </h5>
                            </div>

                            <div class="mt-2">
                                <div class="mb-3">
                                    <h4 class="fw-bold mb-0 text-dark fs-5">R$ @(item.Preco.ToString("N2"))</h4>
                                </div>

                                <div class="d-flex w-100 gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-success flex-fill rounded-pill fw-medium text-white py-2 text-center">
                                        Ver detalhes
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    @@media (max-width: 767.98px) {
        .custom-mobile-img {
            width: 110px !important;
            height: 110px !important;
            flex-shrink: 0;
        }

            .custom-mobile-img::before {
                display: none !important;
            }
    }

    .card-hover-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover-effect:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }
</style>