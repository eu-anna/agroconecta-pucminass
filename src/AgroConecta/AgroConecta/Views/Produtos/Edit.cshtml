@model AgroConecta.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<h4 class="text-center fw-semibold my-3" style="color: #496326;">Editar Produto</h4>

<div class="row shadow-lg p-4 mx-5 rounded-5 m-auto">
    <div class="col-md-12">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div class="row g-4">

                <div class="col-md-6 d-flex flex-column justify-content-start border-end">
                    <div class="form-group text-center">
                        <label class="control-label text-black-50 fw-bold mb-3">Imagem do Produto</label>

                        <div class="mb-3 d-flex justify-content-center align-items-center rounded-5" style="height: 260px; border: 2px dashed grey">
                            @if (Model != null && Model.Imagem != null)
                            {
                                <img id="imgPreview" src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagem)"
                                     class="img-thumbnail rounded-5" style="max-width: 260px; max-height: 246px; display: block;" />
                            }
                            else
                            {
                                <img id="imgPreview" src="#" class="img-thumbnail mx-auto rounded-5"
                                     style="max-width: 260px; max-height: 246px; display: none;" />
                            }
                        </div>

                        <input type="file" name="productImage" id="productImage"
                               class="form-control rounded-5 mb-1" onchange="previewImage(this)" />
                        <small class="text-muted d-block small">Deixe vazio para manter a imagem atual</small>
                    </div>
                </div>

                <div class="col-md-6 ps-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Produtor_id" />

                    <input type="hidden" asp-for="Ativo" id="inputAtivo" />

                    <div class="mb-3">
                        <label class="ms-2 fw-bold text-black-50 small mb-1">Nome do Produto</label>
                        <input asp-for="Nome" class="form-control rounded-5" placeholder="Nome" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="ms-2 fw-bold text-black-50 small mb-1">Descrição</label>
                        <input asp-for="Descricao" class="form-control rounded-5" placeholder="Descrição" />
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="ms-2 fw-bold text-black-50 small mb-1">Preço</label>
                            <input asp-for="Preco" class="form-control rounded-5" placeholder="Preço" />
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="ms-2 fw-bold text-black-50 small mb-1">Estoque</label>
                            <input asp-for="Estoque" id="inputEstoque" class="form-control rounded-5" placeholder="Estoque" oninput="validarStatusEstoque()" />
                            <span asp-validation-for="Estoque" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="ms-2 fw-bold text-black-50 small mb-1">Categoria</label>
                        <select asp-for="Categoria_id" class="form-select rounded-5 shadow-sm"
                                asp-items="ViewBag.Categoria_id">
                            <option value="">Selecione uma Categoria</option>
                        </select>
                        <span asp-validation-for="Categoria_id" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <input type="submit" value="Salvar Alterações" class="btn btn-md btn-success rounded-5 fw-semibold py-2" />
                        <a asp-action="Index" class="btn btn-light btn-md rounded-5 fw-semibold border py-2">Voltar</a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

<script>
    function previewImage(input) {
        const preview = document.getElementById('imgPreview');
        
        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
         }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
