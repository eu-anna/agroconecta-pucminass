@model AgroConecta.Models.Pedido

@{
    ViewData["Title"] = "Meu carrinho";
}

<div class="container mt-5">
    <h4 class="text-center fw-semibold mb-4" style="color: #496326;">Meu Carrinho</h4>

    <div class="row shadow-lg p-2 p-md-4 mx-auto rounded-5 bg-white border-0" style="max-width: 900px;">
        <div class="col-md-12">
            @if (Model.Itens.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle w-100">
                        <thead>
                            <tr class="small">
                                <th class="text-black-50">Produto</th>
                                <th class="text-center text-black-50">Quantidade</th>
                                <th class="text-end text-black-50">Preço</th>
                                <th class="text-end text-black-50">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-black-50 text-truncate d-inline-block" style="max-width: 150px;">
                                            @item.Produto?.Nome
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="number" name="quantity" value="@item.Quantidade"
                                                   class="form-control form-control-sm rounded-4 text-center me-2 w-50"
                                                   onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="text-end text-secondary small">R$ @item.Produto.Preco.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">R$ @((item.Quantidade * item.Produto.Preco)?.ToString("N2"))</td>
                                    <td class="text-end">
                                        <a asp-action="RemoveItem" asp-route-id="@item.Id" class="text-danger">
                                            <i class="bi bi-x-circle-fill fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-end py-3">
                    <span class="text-muted d-block small">Subtotal</span>
                    <h3 class="fw-bold text-success">R$ @Model.Total.ToString("N2")</h3>
                </div>

                <div class="d-grid d-md-flex justify-content-md-between align-items-center mt-4 gap-3">

                    <div class="d-grid d-md-flex gap-2">
                        <a asp-controller="Produtos" asp-action="Index" class="btn btn-sm btn-light rounded-5 text-black-50 border px-4 py-2 py-md-1">
                            Retornar
                        </a>
                        <a asp-controller="Pedidos" asp-action="EmptyCart" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm rounded-5 px-4 py-2 py-md-1" onclick="return confirm('Deseja realmente esvaziar o carrinho?')">
                            Esvaziar Carrinho
                        </a>
                    </div>

                    <a asp-controller="Transacoes" asp-action="Create" asp-route-PedidoId="@Model.Id" class="btn btn-success btn-sm rounded-5 fw-bold shadow px-5 py-2 py-md-1">
                        Fechar Pedido <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x text-muted display-1"></i>
                    <p class="mt-3 text-secondary">Oops! Nada por aqui.</p>
                    <a asp-controller="Produtos" asp-action="Index" class="btn btn-outline-success rounded-5">
                        Retornar às compras
                    </a>
                </div>
            }
        </div>
    </div>
</div>