@model IEnumerable<AgroConecta.Models.Pedido>
@using System.Globalization
@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container mt-5">
    <h4 class="text-center fw-semibold mb-4" style="color: #496326;">Meus Pedidos</h4>

    <div class="row shadow-lg p-4 mx-auto rounded-5 bg-white border-0" style="max-width: 900px;">
        <div class="col-md-12">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="text-black-50 mb-0">Histórico de Compras</h5>
            </div>

            <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                <table class="table table-borderless align-middle table-clickable">
                    <thead class="border-bottom sticky-top bg-white" style="z-index: 1;">
                        <tr>
                            <th class="text-black-50 fw-bold ps-3">Nº do Pedido</th>
                            <th class="text-black-50 fw-bold">Data</th>
                            <th class="text-black-50 fw-bold">Total</th>
                            <th class="text-end text-black-50 fw-bold pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr onclick="window.location='@Url.Action("Details", "Pedidos", new { id = pedido.Id })'">
                                <td class="ps-3 fw-medium text-dark">#@pedido.Id</td>
                                <td class="text-secondary">@pedido.CriadoEm.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold text-dark">@pedido.Total.ToString("C", CultureInfo.CreateSpecificCulture("pt-BR"))</td>
                                <td class="text-end pe-3">
                                    <span class="badge rounded-5 px-3 py-2 fw-semibold"
                                          style="@(pedido.Status == StatusPedido.Entregue ? "background-color: #f0f4ea; color: #496326;" : "background-color: #fff4e5; color: #856404;")">
                                        @pedido.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-clickable tbody tr {
        cursor: pointer;
    }

    .table-clickable tbody tr td {
        transition: background-color 0.3s ease-in-out;
    }

    .table-clickable tbody tr:hover td {
        background-color: #fcfcfc !important;
    }
</style>