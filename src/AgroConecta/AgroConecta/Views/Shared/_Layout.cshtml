@* _Layout.cshtml *@

@{
    var tipo = Context.Session.GetString("TipoUsuario");
    var usuarioLogado = Context.Session.GetString("UsuarioLogado");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroConecta</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgroConecta.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Happy+Monkey&family=Istok+Web:ital,wght@0,400;0,700;1,400;1,700&family=Itim&family=Orbitron:wght@400..900&family=Rammetto+One&family=Work+Sans:ital,wght@0,100..900;1,100..900&family=Zalando+Sans:ital,wght@0,200..900&display=swap" rel="stylesheet">
</head>

<body class="vh-100 overflow-hidden d-flex flex-column">

    <header class="navbar d-lg-none px-3 flex-shrink-0">
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>

    <div class="d-flex flex-grow-1 overflow-hidden">
        <div class="sidebar offcanvas-lg offcanvas-start text-bg-dark flex-shrink-0 d-flex flex-column" tabindex="-1" id="sidebar">

            <div class="offcanvas-header border-bottom border-secondary">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar"></button>
            </div>

            <div class="logo-container d-flex mt-5">
                <a asp-controller="Home" asp-action="Index">
                    <img class="logo-img position-absolute" src="~/images/folha.png" alt="Logo" />
                </a>
                <div class="logo-text-wrap text-center position-relative w-100">
                    <h1 class="logo-title">Agro<span class="logo-part">Conecta</span></h1>
                    <p class="logo-desc">Conectando o agronegócio digitalmente</p>
                </div>
            </div>

            <div class="offcanvas-body d-flex flex-column flex-grow-1 p-3">
                <hr class="opacity-75" />

                <ul class="nav nav-pills flex-column mb-auto gap-0 w-100 mt-3">

                    @* Dashboard: Produtor e Técnico *@
                    @if (tipo == "Produtor" || tipo == "Técnico")
                        {
                            <li class="nav-item d-flex align-items-center">
                                <a class="menu-item nav-link text-white lh-1"
                                asp-controller="Home"
                                asp-action="Index">
                                    <i class="bi bi-pie-chart"></i>
                                    Dashboard
                                </a>
                            </li>
                        }

                    @* Propriedades: Produtor e Técnico *@
                    @if (tipo == "Produtor" || tipo == "Técnico")
                    {
                        <li class="nav-item">
                            <button class="menu-item nav-link text-white w-100 text-start border-0 bg-transparent d-flex justify-content-between align-items-center lh-1"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#meuSubmenuPropriedades"
                                aria-expanded="false"
                                aria-controls="meuSubmenuPropriedades"
                            >
                                <div>
                                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <g clip-path="url(#clip0_17_474)">
                                            <path d="M12.5001 18.3333C12.2791 18.3333 12.0671 18.2455 11.9108 18.0892C11.7545 17.9329 11.6667 17.721 11.6667 17.5V14.1666C11.6667 14.0295 11.7006 13.8944 11.7653 13.7735C11.8299 13.6525 11.9235 13.5494 12.0376 13.4733L14.5376 11.8066C14.6745 11.7153 14.8355 11.6665 15.0001 11.6665C15.1647 11.6665 15.3256 11.7153 15.4626 11.8066L17.9626 13.4733C18.0767 13.5494 18.1702 13.6525 18.2349 13.7735C18.2996 13.8944 18.3334 14.0295 18.3334 14.1666V17.5C18.3334 17.721 18.2456 17.9329 18.0893 18.0892C17.9331 18.2455 17.7211 18.3333 17.5001 18.3333H12.5001Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M15.0001 8.33329C15.0001 6.56518 14.2977 4.86949 13.0475 3.61925C11.7972 2.369 10.1015 1.66663 8.33341 1.66663C6.5653 1.66663 4.86961 2.369 3.61937 3.61925C2.36913 4.86949 1.66675 6.56518 1.66675 8.33329C1.66675 12.4941 6.28258 16.8275 7.83258 18.1658C7.97706 18.2741 8.15282 18.3326 8.33341 18.3325" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M15 18.3334V15.8334" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M8.33325 10.8334C9.71396 10.8334 10.8333 9.71409 10.8333 8.33337C10.8333 6.95266 9.71396 5.83337 8.33325 5.83337C6.95254 5.83337 5.83325 6.95266 5.83325 8.33337C5.83325 9.71409 6.95254 10.8334 8.33325 10.8334Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                        </g>
                                        <defs>
                                            <clipPath id="clip0_17_474">
                                                <rect width="20" height="20" fill="white" />
                                            </clipPath>
                                        </defs>
                                    </svg>
                                    <span class="ms-1"> Propriedades </span>
                                </div>
                                <span class="submenu-arrow">▾</span>
                            </button>

                            <div class="collapse" id="meuSubmenuPropriedades">
                                <ul class="nav flex-column submenu-list">

                                    @if (tipo == "Produtor")
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link submenu-item"
                                               asp-controller="Propriedades"
                                               asp-action="Create">
                                                Cadastrar propriedade
                                            </a>
                                        </li>
                                    }

                                    <li class="nav-item">
                                        <a class="nav-link submenu-item"
                                           asp-controller="Propriedades"
                                           asp-action="Index">
                                            Lista de propriedades
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link submenu-item"
                                           asp-controller="Relatorios"
                                           asp-action="Index">
                                            Relatórios
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        </li>
                    }

                    @* Atividades: Produtor e Técnico *@
                    @if (tipo == "Produtor" || tipo == "Técnico")
                    {
                        <li class="nav-item">
                            <a class="menu-item nav-link text-white lh-1"
                               asp-controller="AtividadesAgricolas"
                               asp-action="Index">
                                <i class="bi bi-clipboard-check"></i>
                                Atividades
                            </a>
                        </li>
                    }

                    @* Clima: Produtor e Técnico *@
                    @if (tipo == "Produtor" || tipo == "Técnico")
                    {
                        <li class="nav-item">
                            <a class="menu-item nav-link text-white lh-1"
                               asp-controller="Clima"
                               asp-action="Index">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <g clip-path="url(#clip0_17_491)">
                                        <path d="M10 1.66663V3.33329" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M10.0001 6.66663C9.23748 6.66624 8.49782 6.92734 7.90447 7.40638C7.31112 7.88541 6.89997 8.55341 6.73959 9.29894C6.57922 10.0445 6.67932 10.8224 7.0232 11.5031C7.36708 12.1837 7.93394 12.7259 8.62923 13.0391" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M1.66675 10H3.33341" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M16.6667 12.1166C17.3022 12.4835 17.7989 13.0498 18.0797 13.7278C18.3605 14.4057 18.4098 15.1573 18.2198 15.8661C18.0299 16.5749 17.6114 17.2012 17.0293 17.6479C16.4471 18.0946 15.7339 18.3367 15.0001 18.3367C14.2663 18.3367 13.553 18.0946 12.9709 17.6479C12.3887 17.2012 11.9702 16.5749 11.7803 15.8661C11.5904 15.1573 11.6397 14.4057 11.9205 13.7278C12.2013 13.0498 12.6979 12.4835 13.3334 12.1166V3.33329C13.3334 2.89127 13.509 2.46734 13.8216 2.15478C14.1341 1.84222 14.5581 1.66663 15.0001 1.66663C15.4421 1.66663 15.866 1.84222 16.1786 2.15478C16.4912 2.46734 16.6667 2.89127 16.6667 3.33329V12.1166Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M4.1084 4.10828L5.2834 5.28328" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M5.2834 14.7167L4.1084 15.8917" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    </g>
                                    <defs>
                                        <clipPath id="clip0_17_491">
                                            <rect width="20" height="20" fill="white" />
                                        </clipPath>
                                    </defs>
                                </svg>
                                Clima
                            </a>
                        </li>
                    }

                    @* Análise: Produtor e Técnico *@
                    @if (tipo == "Produtor" ||  tipo == "Técnico")
                    {
                        <li class="nav-item">
                            <a class="menu-item nav-link text-white lh-1"
                               asp-controller="AnalisesCulturas"
                               asp-action="Index">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M10 4.16667C10.001 3.83336 9.93532 3.50322 9.80685 3.19567C9.67837 2.88811 9.4897 2.60936 9.25191 2.37579C9.01413 2.14222 8.73204 1.95856 8.42224 1.83561C8.11243 1.71266 7.78117 1.6529 7.44793 1.65984C7.1147 1.66679 6.78621 1.7403 6.4818 1.87606C6.17739 2.01181 5.9032 2.20707 5.67536 2.45034C5.44751 2.69361 5.27061 2.97999 5.15506 3.29263C5.03952 3.60527 4.98765 3.93786 5.00252 4.27083C4.51269 4.39678 4.05794 4.63254 3.67271 4.96026C3.28749 5.28798 2.98189 5.69906 2.77906 6.16237C2.57623 6.62569 2.48149 7.12908 2.50201 7.63443C2.52254 8.13978 2.65779 8.63383 2.89752 9.07917C2.476 9.42161 2.14454 9.86186 1.93197 10.3616C1.7194 10.8614 1.63215 11.4055 1.67782 11.9467C1.7235 12.4878 1.9007 13.0096 2.19403 13.4667C2.48735 13.9237 2.88791 14.3022 3.36085 14.5692C3.30245 15.021 3.3373 15.4801 3.46326 15.9179C3.58922 16.3558 3.8036 16.7632 4.09318 17.115C4.38275 17.4667 4.74136 17.7554 5.14687 17.9631C5.55238 18.1709 5.99617 18.2933 6.45083 18.3228C6.9055 18.3523 7.36139 18.2883 7.79034 18.1347C8.2193 17.9811 8.61221 17.7412 8.94482 17.4298C9.27743 17.1184 9.54267 16.7421 9.72416 16.3242C9.90565 15.9063 9.99953 15.4556 10 15V4.16667Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M7.5 10.8333C8.19963 10.5872 8.81057 10.1392 9.25556 9.54584C9.70056 8.95251 9.95962 8.24056 10 7.5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M5.00244 4.27087C5.01892 4.67399 5.13272 5.06712 5.33411 5.41671" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M2.89746 9.08C3.04991 8.95584 3.21305 8.84541 3.38496 8.75" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M5.00001 14.9999C4.4257 15.0002 3.86106 14.8521 3.36084 14.5699" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M10 10.8334H13.3333" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M10 15H15C15.442 15 15.866 15.1756 16.1785 15.4882C16.4911 15.8007 16.6667 16.2246 16.6667 16.6667V17.5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M10 6.66663H16.6667" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M13.3333 6.66667V4.16667C13.3333 3.72464 13.5088 3.30072 13.8214 2.98816C14.134 2.67559 14.5579 2.5 14.9999 2.5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M13.3334 11.25C13.5635 11.25 13.7501 11.0634 13.7501 10.8333C13.7501 10.6032 13.5635 10.4166 13.3334 10.4166C13.1033 10.4166 12.9167 10.6032 12.9167 10.8333C12.9167 11.0634 13.1033 11.25 13.3334 11.25Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M14.9999 2.91671C15.23 2.91671 15.4166 2.73016 15.4166 2.50004C15.4166 2.26992 15.23 2.08337 14.9999 2.08337C14.7698 2.08337 14.5833 2.26992 14.5833 2.50004C14.5833 2.73016 14.7698 2.91671 14.9999 2.91671Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M16.6667 17.9167C16.8968 17.9167 17.0833 17.7302 17.0833 17.5C17.0833 17.2699 16.8968 17.0834 16.6667 17.0834C16.4365 17.0834 16.25 17.2699 16.25 17.5C16.25 17.7302 16.4365 17.9167 16.6667 17.9167Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M16.6667 7.08333C16.8968 7.08333 17.0833 6.89679 17.0833 6.66667C17.0833 6.43655 16.8968 6.25 16.6667 6.25C16.4365 6.25 16.25 6.43655 16.25 6.66667C16.25 6.89679 16.4365 7.08333 16.6667 7.08333Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Análise
                            </a>
                        </li>
                    }

                    @* Fórum: todos *@
                    <li class="nav-item">
                        <a class="menu-item nav-link text-white lh-1"
                           asp-controller="CategoriasForum"
                           asp-action="Index">
                            <i class="bi bi-people"></i>
                            Fórum
                        </a>
                    </li>

                    @* Marketplace: todos, mas "Cadastrar produtos" só Produtor *@
                    <li class="nav-item">
                        <button class="menu-item nav-link text-white w-100 text-start border-0 bg-transparent d-flex justify-content-between align-items-center lh-1"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#menuSubmenuMarketplace"
                                aria-expanded="false"
                                aria-controls="menuSubmenuMarketplace"
                        >
                            <div>
                                <i class="bi bi-shop-window me-1"></i>
                                Marketplace
                            </div>
                            <span class="submenu-arrow">▾</span>
                        </button>

                        <div class="collapse" id="menuSubmenuMarketplace">
                            <ul class="nav flex-column ms-3 mt-1 gap-1">

                                @if (tipo == "Produtor")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link submenu-item py-1"
                                           asp-controller="Produtos"
                                           asp-action="Create">
                                            Cadastrar produtos
                                        </a>
                                    </li>
                                }

                                @if (tipo == "Produtor")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link submenu-item py-1"
                                           asp-controller="CategoriaProdutos"
                                           asp-action="Index">
                                            Categorias de produtos
                                        </a>
                                    </li>
                                }

                                <li class="nav-item">
                                    <a class="nav-link submenu-item py-1"
                                           asp-controller="Produtos"
                                           asp-action="Index">
                                        Produtos
                                    </a>
                                </li>
                                @if (Context.Session.GetString("TipoUsuario") == "Produtor")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link submenu-item py-1"
                                               asp-controller="Pedidos"
                                               asp-action="ListarPedidos">
                                            Vendas
                                        </a>
                                    </li>
                                }

                            </ul>
                        </div>
                    </li>

                </ul>

                <hr class="opacity-75" />

                @if (Context.Session.GetString("NomeUsuario") != null)
                {
                    <ul class="nav nav-pills flex-column gap-0 w-100">
                        <li class="nav-item">
                            <button class="menu-item nav-link text-white w-100 text-start border-0 bg-transparent d-flex justify-content-between align-items-start lh-1"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#menuSubmenuProfile"
                                    aria-expanded="false"
                                    aria-controls="menuSubmenuProfile">

                                <div class="text-white d-flex align-items-start">
                                    <i class="bi bi-person-circle fs-4 me-2"></i>
                                    <div>
                                        <p class="fw-bold mb-1 mt-0 fs-6">@Context.Session.GetString("NomeUsuario")</p>
                                        <span class="fw-light d-block" style="font-size: 0.7rem;">
                                            @Context.Session.GetString("TipoUsuario")
                                        </span>
                                    </div>
                                </div>

                                <span class="submenu-arrow" style="margin-top: 2px;">▾</span>
                            </button>

                            <div class="collapse" id="menuSubmenuProfile">
                                <ul class="nav flex-column ms-3 mt-1 gap-1">
                                    @if (tipo == "Produtor")
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link submenu-item py-1"
                                               asp-controller="Produtos"
                                               asp-action="ManageProducerProducts">
                                                Meus Produtos
                                            </a>
                                        </li>
                                    }

                                    
                                    <li class="nav-item">
                                        <a class="nav-link submenu-item py-1" asp-controller="Pedidos" asp-action="ManageUserPurchases">
                                            Meus Pedidos
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link submenu-item py-1"
                                           asp-controller="Account"
                                           asp-action="Perfil">
                                            Meu Perfil
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                }

                <div class="w-100 px-3 mb-3 mt-3">
                    <a class="menu-item nav-link text-white lh-1"
                       asp-controller="Account"
                       asp-action="Logout">
                        Sair
                    </a>
                </div>

            </div>
        </div>

        <div class="flex-grow-1 overflow-auto w-100">
            <div class="container py-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>

    @if (usuarioLogado != null)
    {
        <a asp-controller="Pedidos" asp-action="Index"
           class="btn btn-success rounded-circle shadow-lg d-flex align-items-center justify-content-center position-fixed"
           style="top: 10px; right: 10px; width: 48px; height: 48px; z-index: 2500; border: 2px solid white;">
            <i class="bi bi-cart3 fs-4 text-white"></i>
        </a>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
