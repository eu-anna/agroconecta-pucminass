@model AgroConecta.Models.CategoriaProduto

@{
    ViewData["Title"] = "Editar Categoria";
}

<h4 class="text-center fw-semibold mt-5" style="color: #496326;">Editar Categoria</h4>
<hr class="mb-4" />

<div class="container">
    <div class="row shadow-lg p-5 rounded-5 m-auto" style="max-width: 500px; background-color: #fff;">
        <div class="col-md-12">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-4">
                    <label asp-for="Nome" class="ms-2 fw-bold text-black-50 small">Nome da Categoria</label>
                    <input asp-for="Nome" class="form-control rounded-5 p-3 shadow-sm" placeholder="Ex: Grãos, Frutas..." />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group d-grid gap-2">
                    <input type="submit" value="Salvar Alterações" class="btn btn-md rounded-5 fw-semibold p-2"
                           style="background-color: #496326; color: #fff;" />
                    
                    <a asp-action="Index" class="btn btn-light btn-md rounded-5 fw-semibold border shadow-sm">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}