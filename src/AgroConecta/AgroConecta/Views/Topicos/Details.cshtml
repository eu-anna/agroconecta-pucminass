@model AgroConecta.Models.TopicoModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Titulo;
}

<div class="d-flex flex-column vh-100" style="background-color: #f5f5f5">

    <div class="d-flex flex-column justify-content-center align-items-center w-100 m-auto flex-grow-1">
        <div class="p-5 bg-white rounded-2" style="width:95%; box-shadow: 0px 10px 11px -4px rgba(0,0,0,0.08)">
            <h1 class="text-center mb-4 page-title rounded-2 m-auto">@Model.Titulo</h1>

            <div class="mb-4 border-bottom pb-3 d-flex justify-content-between align-items-center">
                <small style="font-size:12px">Publicado em @Model.CriadoEm.ToString("dd/MM/yyyy 'às' HH:mm")</small>
                <a asp-action="Index" asp-route-categoriaId="@Model.CategoriaId" class="text-decoration-none" style="font-size:12px; color: #5E5C5C">
                    Voltar
                </a>
            </div>

            <div class="conteudo-topico" style="min-height: 200px; font-size:16px">
                @Model.Conteudo
            </div>

            <div class="d-flex align-items-center justify-content-between border-top pt-4">
                
                <div class="d-flex align-items-center justify-content-between w-100">
                    <form asp-controller="Topicos" asp-action="Curtir" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-dark d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 lucide lucide-thumbs-up"><path d="M7 10v12" /><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z" /></svg>
                            Curtir
                        </button>
                    </form>
                    <span>
                        Curtidas
                        @Model.Curtidas

                    </span>
                </div>

            </div>

        </div>
    </div>
</div>

<div class="d-flex flex-column justify-content-center align-items-center w-100 m-auto" style="background-color: #f5f5f5">
    <div class="d-flex flex-column justify-content-center align-items-center m-auto rounded-2" style="width:95% ">
        @foreach (var comentario in Model.Comentarios.OrderBy(c => c.CriadoEm))
        {
            <div class="bg-white my-3 mb-3 p-3 w-100 rounded-2" style="box-shadow: 0px 10px 11px -4px rgba(0,0,0,0.08)">
                <small class="mb-4" style="font-size:12px">
                    Respondido em @comentario.CriadoEm.ToString("dd/MM/yyyy 'às' HH:mm")
                </small>
                <div style="font-size:16px">@comentario.Conteudo</div>
                            
                <div class="d-flex justify-content-end mt-2">
                    <form asp-controller="Comentarios" asp-action="Curtir" method="post">
                        <input type="hidden" name="id" value="@comentario.Id" />
            
                        <input type="hidden" name="topicoId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-none d-flex align-items-center justify-content-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5E5C5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 lucide lucide-thumbs-up"><path d="M7 10v12" /><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z" /></svg>
                            @comentario.Curtidas
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="card text-white m-5 p-4 border-0 w-100">
            <form asp-controller="Comentarios" asp-action="Create" method="post">

                <input type="hidden" name="TopicoId" value="@Model.Id" />
                        
                <div class="form-group mb-3">
                    <textarea name="Conteudo" class="form-control" rows="3" placeholder="Escreva seu comentário aqui..." required></textarea>
                </div>
                        
                <div class="d-flex justify-content-end">
                    <button type="submit" class="border-0 rounded-4 p-2" style="font-size: 12px; color: #5E5C5C">Enviar Resposta</button>
                </div>
            </form>
        </div>
    </div>
</div>
