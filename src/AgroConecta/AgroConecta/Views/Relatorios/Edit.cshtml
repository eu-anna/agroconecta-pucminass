@model AgroConecta.Models.Relatorio

@{
    ViewData["Title"] = "Editar Relatório";
}

<h1 class="page-title">Editar Relatório</h1>

<div class="agro-card form-card">

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />

        <select asp-for="PropriedadeId"
                class="agro-input"
                asp-items="ViewBag.PropriedadeId">
        </select>

        <input asp-for="TecnicoId" type="hidden" />

        <textarea asp-for="Conteudo"
                  class="agro-textarea"
                  placeholder="Conteúdo do relatório"></textarea>

        @if (!string.IsNullOrEmpty(Model.ImagemPath))
        {
            <div style="margin-bottom:16px; display:flex; flex-direction:column; align-items:flex-start; gap:10px;">
                <img src="@Model.ImagemPath"
                     style="max-width:300px; border-radius:12px;" />
            </div>
        }

        <input type="file"
               name="Imagem"
               class="agro-input"
               accept="image/*" />

        <button type="submit" class="agro-btn">
            Salvar alterações
        </button>

        @if (!string.IsNullOrEmpty(Model.ImagemPath))
        {
            <a asp-action="RemoverImagem"
               asp-route-id="@Model.Id"
               class="agro-btn danger-btn"
               style="display:block; text-align:center; margin-top:10px; max-width:560px; margin-left:auto; margin-right:auto;">
                Excluir imagem
            </a>
        }

    </form>

</div>

