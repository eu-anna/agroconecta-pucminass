@model IEnumerable<AgroConecta.Models.Relatorio>

@{
    ViewData["Title"] = "Relatórios";
}

<h1 class="page-title">Relatórios</h1>

<div class="agro-card">

    <table class="agro-table">

        <thead>
            <tr>
                <th>Propriedade</th>
                <th>Técnico</th>
                <th>Data Cadastro</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Propriedade?.Nome</td>

                    <td>@item.TecnicoId</td>

                    <td>@item.CriadoEm.ToString("dd/MM/yyyy")</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="agro-action">
                            Editar
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="agro-action">
                            Visualizar
                        </a>

                        <a asp-action="ExportarPdf"
   asp-route-id="@item.Id"
   class="agro-action">
    Exportar PDF
</a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="agro-action danger">
                            Excluir
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
